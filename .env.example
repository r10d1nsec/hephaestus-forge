# ============================================================
#  Hephaestus' Forge — environment configuration
#  Copy to .env:  cp .env.example .env
#  Everything is OPTIONAL — engines can also be configured in the UI.
#  Keys live only in the local SQLite DB; nothing leaves your machine.
# ============================================================

# --- Backend ---
SECRET_KEY=hephaestus-dev-key-change-me
DATABASE_URL=sqlite:////app/data/hephaestus.db
# Comma-separated origins allowed to call the API (frontend dev + docker)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Optional: pre-seed an API engine (otherwise configure in Settings → Engines) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OpenAI-compatible providers (OpenRouter, Groq, Together, ...) — set base_url + key
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# --- Optional: Ollama (local models) ---
# In docker, point to host: http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434

# --- Frontend (build-time) ---
VITE_API_URL=http://localhost:8000
